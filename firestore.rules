rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can only read/write their own profile
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Game results collection - authenticated users can create their own results
    match /gameResults/{resultId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Game results are immutable
    }
    
    // Leaderboards - anyone can read, authenticated users can write their own scores
    match /leaderboards/{category}/{difficulty}/{entryId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Leaderboard entries are immutable
    }
  }
}
